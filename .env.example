# Names only. Real values go in .env.local, which is never committed.
# NEXT_PUBLIC_* values are rendered on the page and are inlined at build time,
# so rebuild after changing them. Everything else stays on the server.

# ---------------------------------------------------------------
# Site-wide
# ---------------------------------------------------------------
# Where every call to action on the home page (/) points. Use the booking page,
# for example /sip?src=site. Unset, the buttons link to "#".
NEXT_PUBLIC_LANDING_URL=
# Absolute origin of the site, used for share-image links and the intake links
# sent to leads (for example https://himlifeschool.com)
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------
# Home page (/), the "At Your Own Desk" story
# ---------------------------------------------------------------
# "true" shows dashed placeholders for the credential line and student quotes
# that are still awaiting approval. "true" for the approval preview.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
# "true" adds robots noindex,nofollow and a robots.txt that disallows all.
# Keep "true" until launch. (/sip is always noindex until launch, set in its layout.)
NEXT_PUBLIC_NOINDEX=true
# Optional. GA4 measurement ID, e.g. G-XXXXXXXXXX. Not wired yet.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------
# Booking page (/sip) and /api/book/*
# ---------------------------------------------------------------
# Calendly booking page shown after the details step (the consultation is free).
# Unset: step 3 says "booking opens soon" and shows the support contacts.
# For example https://calendly.com/<account>/<event>
NEXT_PUBLIC_CALENDLY_URL=
# Optional. Calendly personal access token (Calendly > Integrations > API & webhooks),
# so the server can save the booked time on the lead and in the Google Sheet.
CALENDLY_API_TOKEN=

# Business details (fill in when known)
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_CONSULTANT_NAME=
NEXT_PUBLIC_CONSULTATION_DURATION_MIN=
# How the consultation is held, for example "Online video call"
NEXT_PUBLIC_CONSULTATION_MODE=
NEXT_PUBLIC_BLUEPRINT_FORMAT=
NEXT_PUBLIC_BLUEPRINT_TURNAROUND=
NEXT_PUBLIC_POLICY_PUBLISHED=false

# Adapters (stubs until chosen)
# local-json = .data/ on this machine (dev only; does not work on Vercel).
# redis = Upstash Redis, fast; recommended on Vercel (docs/lead-storage-setup.md).
#   With BOOK_SHEETS_URL set, every lead is also copied to the Google Sheet in the background.
# google-sheets = the sheet alone as the store (works, but slow).
LEAD_STORE=local-json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BOOK_SHEETS_URL=
BOOK_SHEETS_SECRET=
EMAIL_PROVIDER=console
EMAIL_SENDER_ADDRESS=
INTAKE_STORE=stub
# Where owner alerts go (logged until email is set up)
OWNER_ALERT_EMAIL=

# Server secrets for /book
# Signs the per-lead links (booking status, intake). Any long random string.
BOOK_TOKEN_SECRET=
# Bearer token for /api/book/admin/* (leads list, status updates). Admin API is off when unset.
BOOK_ADMIN_TOKEN=
# Dev/test only: lets the test script inject storage failures. Keep false.
BOOK_TEST_HOOKS=false
