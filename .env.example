# Names only. Real values go in .env.local, which is never committed.
# NEXT_PUBLIC_* values are rendered on the page and are inlined at build time,
# so rebuild after changing them. Everything else stays on the server.

# Teaser -> landing (for example https://<domain>/book?src=site)
NEXT_PUBLIC_LANDING_URL=
# Absolute origin of the site, used for share-image links (for example https://<domain>)
NEXT_PUBLIC_SITE_URL=

# Razorpay (test mode; real values go in .env.local only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# test = Razorpay test keys (rzp_test_ only). mock = local simulated checkout, no Razorpay calls;
# mock also needs BOOK_TEST_HOOKS=true and must never be used on a deployed site.
RAZORPAY_MODE=test

# Offer
CONSULTATION_FEE_INR=3000
NEXT_PUBLIC_CONSULTATION_TAX_LABEL=inclusive of all taxes
INVOICE_TYPE=standard

# Business details (fill in when known)
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_CONSULTANT_NAME=
NEXT_PUBLIC_CONSULTATION_DURATION_MIN=
# How the consultation is held, for example "Online video call"
NEXT_PUBLIC_CONSULTATION_MODE=
NEXT_PUBLIC_BLUEPRINT_FORMAT=
NEXT_PUBLIC_BLUEPRINT_TURNAROUND=
NEXT_PUBLIC_REFUND_PROCESSING_TIME=
NEXT_PUBLIC_POLICY_PUBLISHED=false

# Slots (synthetic when unset)
SLOTS_SOURCE=synthetic
# With SLOTS_SOURCE=config: comma-separated start times, for example 2026-11-20T10:00+05:30
SLOTS_CONFIG=
CAPACITY_PER_DAY=
SLOT_HOLD_MINUTES=10

# Adapters (stubs until chosen)
# local-json = .data/ on this machine (dev only; does not work on Vercel).
# google-sheets = Apps Script web app, see docs/google-sheets-setup.md.
LEAD_STORE=local-json
BOOK_SHEETS_URL=
BOOK_SHEETS_SECRET=
EMAIL_PROVIDER=console
EMAIL_SENDER_ADDRESS=
INTAKE_STORE=stub
# Where "charged but no slot" and other owner alerts go (logged until email is set up)
OWNER_ALERT_EMAIL=

# Payment per route (default paid on both)
PAYMENT_REQUIRED_NOV=true
PAYMENT_REQUIRED_MAY=true

# Server secrets for /book
# Signs the per-lead links (confirmation, intake). Any long random string.
BOOK_TOKEN_SECRET=
# Bearer token for /api/book/admin/* (status updates, refunds). Admin API is off when unset.
BOOK_ADMIN_TOKEN=
# Dev/test only: lets the test script inject storage and payment failures. Keep false.
BOOK_TEST_HOOKS=false
