[Unit]
Description=Redis for the HLS booking site (port 6380)
After=network.target

[Service]
Type=notify
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/redis/redis-hls.conf --supervised systemd --daemonize no
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
